# Neo4j Settings
NEO4J_URI=neo4j://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=KnowledgeGraph

# OpenAI settings (leave blank to run in Dynamic Fallback / In-Memory Mode)
