# Neo4j Settings
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# OpenAI settings (leave blank to run in Dynamic Fallback / In-Memory Mode)
OPENAI_API_KEY=
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Fallback control
# Set to 'true' to force zero-dependency in-memory databases and templates
FORCE_FALLBACK=false
